# Netlify > Site configuration > Environment variables (Production).
# Replace with the actual assigned URL and enable only after public review.
# NEXT_PUBLIC_SITE_URL=https://sebastechisme.netlify.app
# SEO_ALLOW_INDEXING=true

# Without both values, production remains noindex. Netlify supplies URL
# automatically for correct social previews before search indexing is enabled.
# NEXT_PUBLIC_PREVIEW_ORIGIN=http://192.168.1.109:8188
